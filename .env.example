NODE_ENV=development

# Supabase
SUPABASE_URL=
# Server-side only. Never exposed to the web app.
SUPABASE_SERVICE_ROLE_KEY=
# The public anon key. The web app uses it only to sign people in; all
# company data still goes through the API, which checks membership.
SUPABASE_ANON_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Local embedding model for semantic recall of company knowledge
# (`ollama pull nomic-embed-text`). Knowledge is embedded on this machine and
# never sent to a third party. Leave empty to fall back to keyword recall.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Seeds the development organization and its workforce on startup.
# Always false in production: it would create a demo company in the real
# database.
SEED_DEVELOPMENT_WORKFORCE=true

# Application
# The web app in a deployment. Locally these are not needed: the app falls back
# to the API on this machine and to localhost redirects. In production both are
# required - see docs/deployment/README.md.
#   VITE_API_URL=https://api.unioffice.pro
#   VITE_APP_ORIGIN=https://unioffice.pro
API_PORT=4000
# The address the API listens on. Loopback by default, so a development
# machine is not serving the network. A deployment behind a reverse proxy on
# the same host keeps this; a container sets 0.0.0.0.
HOST=127.0.0.1
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Origins the browser may call the API from. An explicit list, no wildcards.
# In production: https://unioffice.pro,https://www.unioffice.pro
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Connections to external systems (optional)
# Seals every stored provider token (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required once any provider below is set. Never commit a real value.
CONNECT_ENCRYPTION_KEY=
# GitHub OAuth App. Callback URL: <API_URL>/connections/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (Web application) with the Drive API enabled.
# Redirect URI: <API_URL>/connections/oauth/google_drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Durable execution worker
# How long the worker waits after finding nothing to do.
WORKER_POLL_INTERVAL_MS=2000
# How long a worker's claim on a job is good for. Must comfortably outlast a
# real objective (minutes), or a healthy worker loses its own job to recovery.
WORKER_LEASE_MS=600000
# How many jobs one worker executes at once.
WORKER_CONCURRENCY=2

# How long a work row may sit mid-run before startup treats it as abandoned.
EXECUTION_STALE_AFTER_MINUTES=15
